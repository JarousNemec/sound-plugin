{
  "schemaVersion": 1,
  "id": "demo-midi",
  "name": "Demo (MIDI)",
  "author": "SoundPlugin",
  "description": "Demo pack with a short MIDI-style cue for every lifecycle event and a curated set of IDE actions. Generated by ./gradlew generateDemoSounds - do not edit by hand.",
  "version": "1.1.0",
  "defaultMappings": [
    { "eventId": "build.finished.success", "soundFile": "sounds/build_success.wav", "volume": 70 },
    { "eventId": "build.finished.failed", "soundFile": "sounds/build_failed.wav", "volume": 75 },
    { "eventId": "run.process.started", "soundFile": "sounds/run_started.wav", "volume": 45 },
    { "eventId": "run.process.terminated.success", "soundFile": "sounds/run_ok.wav", "volume": 55 },
    { "eventId": "run.process.terminated", "soundFile": "sounds/run_failed.wav", "volume": 65 },
    { "eventId": "debug.breakpoint.hit", "soundFile": "sounds/debug_paused.wav", "volume": 50 },
    { "eventId": "test.finished.passed", "soundFile": "sounds/test_passed.wav", "volume": 70 },
    { "eventId": "test.finished.failed", "soundFile": "sounds/test_failed.wav", "volume": 75 },
    { "eventId": "vcs.commit.completed", "soundFile": "sounds/vcs_commit.wav", "volume": 60 },
    { "eventId": "vcs.update.completed", "soundFile": "sounds/vcs_update.wav", "volume": 50 },
    { "eventId": "indexing.finished", "soundFile": "sounds/indexing_done.wav", "volume": 40 },
    { "eventId": "notification.shown.info", "soundFile": "sounds/notify_info.wav", "volume": 30 },
    { "eventId": "notification.shown.warning", "soundFile": "sounds/notify_warning.wav", "volume": 50 },
    { "eventId": "notification.shown.error", "soundFile": "sounds/notify_error.wav", "volume": 65 },
    { "eventId": "file.saved", "soundFile": "sounds/file_saved.wav", "volume": 30 },
    { "eventId": "project.opened", "soundFile": "sounds/project_opened.wav", "volume": 55 },
    { "eventId": "project.closed", "soundFile": "sounds/project_closed.wav", "volume": 50 },
    { "eventId": "app.frame.activated", "soundFile": "sounds/frame_activated.wav", "volume": 20 },
    { "eventId": "$Copy", "soundFile": "sounds/action_copy.wav", "volume": 30 },
    { "eventId": "$Cut", "soundFile": "sounds/action_cut.wav", "volume": 30 },
    { "eventId": "$Paste", "soundFile": "sounds/action_paste.wav", "volume": 30 },
    { "eventId": "EditorDuplicate", "soundFile": "sounds/action_duplicate.wav", "volume": 30 },
    { "eventId": "EditorDeleteLine", "soundFile": "sounds/action_delete_line.wav", "volume": 30 },
    { "eventId": "$Undo", "soundFile": "sounds/action_undo.wav", "volume": 30 },
    { "eventId": "$Redo", "soundFile": "sounds/action_redo.wav", "volume": 30 },
    { "eventId": "CommentByLineComment", "soundFile": "sounds/action_comment.wav", "volume": 30 },
    { "eventId": "ReformatCode", "soundFile": "sounds/action_reformat.wav", "volume": 30 },
    { "eventId": "OptimizeImports", "soundFile": "sounds/action_optimize_imports.wav", "volume": 30 },
    { "eventId": "RenameElement", "soundFile": "sounds/action_rename.wav", "volume": 35 },
    { "eventId": "ExtractMethod", "soundFile": "sounds/action_extract_method.wav", "volume": 35 },
    { "eventId": "ShowIntentionActions", "soundFile": "sounds/action_intention.wav", "volume": 20 },
    { "eventId": "GotoFile", "soundFile": "sounds/action_goto_file.wav", "volume": 35 },
    { "eventId": "GotoClass", "soundFile": "sounds/action_goto_class.wav", "volume": 35 },
    { "eventId": "GotoDeclaration", "soundFile": "sounds/action_goto_declaration.wav", "volume": 35 },
    { "eventId": "FindInPath", "soundFile": "sounds/action_find_in_path.wav", "volume": 30 },
    { "eventId": "SearchEverywhere", "soundFile": "sounds/action_search_everywhere.wav", "volume": 30 },
    { "eventId": "Vcs.Push", "soundFile": "sounds/action_push.wav", "volume": 45 },
    { "eventId": "ToggleLineBreakpoint", "soundFile": "sounds/action_toggle_breakpoint.wav", "volume": 30 }
  ]
}
